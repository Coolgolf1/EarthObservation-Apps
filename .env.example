# Database Configuration
DB_HOST=your_database_host
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_SCHEMA=public
DB_TABLE=natural_earth
DB_SSLMODE=require
DB_TOKEN=your_database_token

# API Keys
ESRI_API_KEY=your_esri_api_key
OSM_ORS_API_KEY=your_openroute_api_key
PLANET_API_KEY=your_planet_api_key
MAPBOX_TOKEN=your_mapbox_token
