# Fill in the integrations you use. Empty optional keys keep the map preview working.

# PostGIS (required for EarthSearch and EarthMapper feature data)
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_SSLMODE=require
DB_TOKEN=

# Optional integrations
ESRI_API_KEY=
OSM_ORS_API_KEY=
PLANET_API_KEY=
MAPBOX_TOKEN=
LLM_API_KEY=
LLM_API_URL=https://openrouter.ai/api/v1/chat/completions
# Set LLM_MODEL to a model available to your provider, if needed.
# LLM_MODEL=your_model_name

# Optional: ImageCubes API
# IMAGECUBES_API_URL=https://your-imagecubes-api-url
IMAGECUBES_TOKEN=
